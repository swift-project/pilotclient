/*
 * Design tokens
 * Background:  #1e2433  (dark navy)
 * Surface:     #252d3d  (panel/card)
 * Surface2:    #2c3448  (elevated panel)
 * Border:      #3a4560  (subtle divider)
 * Accent:      #4a9eff  (blue)
 * Accent-dim:  rgba(74,158,255,0.20)
 * Text:        #e0e6f0
 * Text-dim:    #8a96a8
 * Error:       #e05c5c
 * Warning:     #f0b429
 * Success:     #3ecf8e
 *
 * Used dynamic properties:
 *   framelessMainWindow  (infobar.qss, swiftstdgui.qss)
 *   readOnly             (QLineEdit, QCheckBox)
 *   validation           (QLineEdit: error/warning/ok)
 *   blinkOn              (QPushButton)
 *   supervisormsg        (QTabBar, QTextEdit)
 */

QFrame {
  border-style: solid;
  border-color: transparent;
  border-width: 1px;
}

QCheckBox {
  border: 0px;
  background: transparent;
}

QCheckBox::indicator {
  color: #8a96a8;
  border: 1px solid #3a4560;
  background: #1e2433;
  width: 14px;
  height: 14px;
  border-radius: 3px;
}

QCheckBox::indicator:checked {
  background: #4a9eff;
  border-color: #4a9eff;
  image: url(:/diagona/icons/diagona/icons/tick.png);
}

QCheckBox::indicator:indeterminate {
  image: url(:/diagona/icons/diagona/icons/question.png);
}

/* Main window */
QMainWindow {
  background-color: #1e2433;
}

QMainWindow::separator {
  background: transparent;
  width: 0px;
  height: 0px;
}

QMainWindow::separator:hover {
  background: transparent;
}

/* Dialog */
QDialog {
  background-color: #1e2433;
}

QDialog::separator {
  background: transparent;
  width: 0px;
  height: 0px;
}

QDialog::separator:hover {
  background: transparent;
}

QFileDialog #sidebar {
  background: #1e2433;
}

QFileDialog QToolButton {
  background: inherit;
}

swift--gui--CDockWidgetInfoArea {
  background-color: #4a9eff; /* use accent for border strip */
}

/* outer widget in dock widget */
swift--gui--CDockWidgetInfoArea > QWidget[dockwidget="outerwidget"] {
  background: #252d3d;
}

/* inner frame in frameless dock widget */
swift--gui--CDockWidgetInfoArea[framelessDockWidget="true"] > QWidget > QFrame[dockwidget="innerwidget"] {
  margin: 0px;
  padding: 3px;
  border: 2px solid #4a9eff;
  border-radius: 10px;
}

swift--gui--CDockWidgetInfoArea[framelessDockWidget="false"] > QWidget > QFrame[dockwidget="innerwidget"] {
  /* void */
}

swift--gui--CInfoArea {
  background: #252d3d;
}

/* Overlay messages */
swift--gui--COverlayMessages {
  background-color: rgba(30, 36, 51, 0.93);
  border: 1px solid #3a4560;
  border-radius: 10px;
}

swift--gui--CDropSite {
  color: #8a96a8;
  border: 2px dashed #3a4560;
  border-radius: 5px;
  min-height: 18px;
  max-height: 18px;
  margin: 2px;
  padding: 2px;
}

/* Validator bar */
swift--gui--Editors--CValidationIndicator {
  background: #252d3d;
}

swift--gui--CPluginDetailsWindow,
swift--gui--CPluginConfigWindow {
  background: #1e2433;
}

swift--gui--Components--CDBusServerAddressSelector::disabled {
  background: rgba(30, 36, 51, 0.65);
}

swift--gui--Components--CSimulatorSelector::disabled {
  background: rgba(30, 36, 51, 0.65);
}

swift--gui--Components--CAircraftModelSetValidationDialog,
swift--gui--Components--CCoreSettingsDialog,
swift--gui--Views--CAircraftModelValidationDialog,
swift--gui--Views--CAircraftModelStatisticsDialog,
swift--gui--Components--CSettingsFontDialog,
swift--gui--Components--CAirportDialog,
swift--gui--Components--CTextEditDialog,
swift--gui--Components--CSetupLoadingDialog,
swift--gui--Components--CDownloadComponent,
swift--gui--Components--CDownloadDialog,
swift--gui--Components--CUpdateInfoDialog,
swift--gui--Components--CRawFsdMessagesComponent,
swift--gui--Components--CRawFsdMessagesDialog,
swift--gui--Components--CDbOwnModelsDialog,
swift--gui--Components--CDbOwnModelSetDialog,
swift--gui--Components--CFirstModelSetComponent,
swift--gui--Components--CDbAircraftIcaoComponent,
swift--gui--Components--CDbLiveryComponent,
swift--gui--Components--CDbDistributorComponent,
swift--gui--Components--CLegalInfoComponent,
swift--gui--Components--CStringListDialog
{
  background: #252d3d;
}

swift--gui--Components--CCockpitComComponent {
  min-height: 7em;
}

/* --- Buttons --- */

QToolButton {
  background-color: rgba(74, 158, 255, 0.18);
  border: 1px solid #3a4560;
  border-radius: 4px;
  padding: 2px 4px;
}

QToolButton:hover {
  background-color: rgba(74, 158, 255, 0.30);
  border-color: #4a9eff;
}

QToolButton:pressed {
  background-color: rgba(74, 158, 255, 0.45);
}

#tb_AtcStationsAtisReload,
#tb_AtcStationsLoadMetar,
#tb_Audio,
#tb_TextMessageOverlay,
QPushButton {
  background-color: rgba(74, 158, 255, 0.22);
  border: 1px solid #4a9eff;
  border-radius: 6px;
  color: #e0e6f0;
  padding: 3px 10px;
  margin-right: 4px;
  min-width: 55px;
  min-height: 22px;
}

QPushButton:hover {
  background-color: rgba(74, 158, 255, 0.38);
  border-color: #7ab8ff;
}

QPushButton:pressed {
  background-color: rgba(74, 158, 255, 0.55);
}

QPushButton:disabled {
  background-color: rgba(58, 69, 96, 0.45);
  border: 1px solid #3a4560;
  color: #8a96a8;
  padding: 3px 10px;
  margin-right: 4px;
}

QPushButton[blinkOn="true"] {
  background-color: #f0b429;
  color: #1e2433;
  border-color: #f0b429;
}

/* --- Progress bar --- */

QProgressBar {
  border: 1px solid #3a4560;
  border-radius: 5px;
  background-color: #1e2433;
  text-align: center;
  padding: 0px;
  height: 16px;
  color: #e0e6f0;
}

QProgressBar::chunk {
  background-color: #4a9eff;
  border-radius: 4px;
  margin: 1px;
}

/* --- Tabs --- */

QTabWidget::pane {
  border: 1px solid #3a4560;
  border-radius: 4px;
}

QTabWidget::tab-bar {
  left: 5px;
}

QTabBar::tab {
  background: #1e2433;
  border: 1px solid #3a4560;
  border-bottom: none;
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
  min-width: 30px;
  padding: 4px 8px;
  margin-right: 2px;
  color: #8a96a8;
}

QTabBar::tab:selected {
  background-color: #252d3d;
  color: #e0e6f0;
  border-bottom-color: #252d3d;
}

QTabBar::tab:hover {
  background: #2c3448;
  color: #e0e6f0;
}

QTabBar::tear {
  image: url(:/own/icons/own/transparent1px.png);
  max-width: 1px;
}

QTabBar QToolButton {
  background-color: rgba(74, 158, 255, 0.25);
  border: 1px solid #3a4560;
}

/* --- Splitter --- */

QSplitter {
  margin: 0px;
  border: 0px;
  padding: 0px;
}

QSplitter::handle {
  background-color: #3a4560;
  margin-top: 1px;
  margin-bottom: 1px;
  height: 1px;
}

QSplitter::handle:pressed {
  background-color: #4a9eff;
}

/* --- Labels --- */

QLabel {
  background: transparent;
}

/* --- Input fields --- */

QLineEdit {
  background: #252d3d;
  border: 1px solid #3a4560;
  border-radius: 5px;
  padding: 2px 6px;
  color: #e0e6f0;
}

QLineEdit:focus {
  border-color: #4a9eff;
}

QLineEdit[readOnly="true"] {
  background: #1e2433;
  border-color: #2c3448;
  color: #8a96a8;
}

QLineEdit:disabled {
  background: #1e2433;
  border-color: #2c3448;
  color: #8a96a8;
}

QLineEdit[validation="error"]   { border: 2px solid #e05c5c; }
QLineEdit[validation="warning"] { border: 2px solid #f0b429; }
QLineEdit[validation="ok"]      { border: 2px solid #3ecf8e; }

QTextEdit {
  border: 1px solid #3a4560;
  background: #252d3d;
  border-radius: 5px;
  color: #e0e6f0;
}

QTextEdit:focus {
  border-color: #4a9eff;
}

QPlainTextEdit {
  border: 1px solid #3a4560;
  background: #252d3d;
  border-radius: 5px;
  color: #e0e6f0;
}

QPlainTextEdit:focus {
  border-color: #4a9eff;
}

/* --- Group boxes --- */

QGroupBox {
  border: 1px solid #3a4560;
  margin-top: 1.1em;
  padding-top: 0.5em;
  border-radius: 6px;
  background: #252d3d;
}

QGroupBox:disabled {
  background: rgba(30, 36, 51, 0.50);
}

QGroupBox::unchecked { border: 0px; }

QGroupBox::title {
  top: 2px;
  left: 1em;
  subcontrol-origin: margin;
  subcontrol-position: top left;
  padding: 0px 6px;
  background-color: #252d3d;
  color: #4a9eff;
  border: none;
  border-radius: 3px;
}

/* --- Tool boxes --- */

QToolBox::tab {
  border: 1px solid #3a4560;
  border-radius: 5px;
  padding: 4px 8px;
  background: #1e2433;
  color: #8a96a8;
}

QToolBox::tab:selected {
  color: #e0e6f0;
  background-color: rgba(74, 158, 255, 0.22);
  border-color: #4a9eff;
}

QToolBox::tab:!selected {
  background-color: rgba(74, 158, 255, 0.08);
}

QToolBox > QWidget {
  border: 0px;
}

/* --- Combo boxes --- */

QComboBox {
  border: 1px solid #3a4560;
  border-radius: 5px;
  padding: 2px 6px;
  background: #252d3d;
  color: #e0e6f0;
  selection-background-color: #4a9eff;
}

QComboBox:focus {
  border-color: #4a9eff;
}

QComboBox:disabled {
  background: #1e2433;
  border-color: #2c3448;
  color: #8a96a8;
}

QComboBox::drop-down {
  border: none;
  width: 20px;
}

QComboBox QAbstractItemView {
  background-color: #252d3d;
  color: #e0e6f0;
  border: 1px solid #3a4560;
  selection-background-color: #4a9eff;
}

/* --- Spin boxes --- */

QDoubleSpinBox {
  border: 1px solid #3a4560;
  border-radius: 5px;
  padding: 2px 4px;
  background: #252d3d;
  color: #e0e6f0;
}

QDoubleSpinBox:focus { border-color: #4a9eff; }

QSpinBox {
  border: 1px solid #3a4560;
  border-radius: 5px;
  padding: 2px 4px;
  background: #252d3d;
  color: #e0e6f0;
}

QSpinBox:focus { border-color: #4a9eff; }

/* --- Color / menu dialogs --- */

QColorDialog {
  background-color: #1e2433;
}

/* --- Menu bar --- */

QMenuBar {
  background-color: #1e2433;
  padding: 4px 0px 0px 8px;
  margin: 0px 0px 30px 0px;
}

QMenuBar::item {
  spacing: 5px;
  padding: 3px 6px;
  background: transparent;
  border-radius: 4px;
  color: #e0e6f0;
}

QMenuBar::item:selected {
  background: #252d3d;
}

QMenuBar::item:pressed {
  background: #3a4560;
}

swift--gui--CDockWidgetInfoArea > QMenu > QMenuWidget {
  border: 0px;
}

/* reset menu style for pop-up menus */
QMenu {
  color: #1e2433;
  background-color: #f0f0f0;
  font-style: normal;
  font-weight: normal;
  padding: 4px;
  border: 1px solid #c0c0c0;
  border-radius: 4px;
}

QMenu > QFrame {
  color: #1e2433;
}

swift--gui--Components--CMarginsInput QLineEdit {
  color: #1e2433;
}

/* --- Radio buttons --- */

QRadioButton::indicator:checked, QRadioButton::indicator:unchecked {
  color: #8a96a8;
  background-color: #1e2433;
  border: 1px solid #3a4560;
  border-radius: 7px;
  width: 13px;
  height: 13px;
}

QRadioButton::indicator:checked {
  background-color: qradialgradient(
    cx: 0.5, cy: 0.5,
    fx: 0.5, fy: 0.5,
    radius: 1.0,
    stop: 0.25 #4a9eff,
    stop: 0.3 #1e2433
  );
  border-color: #4a9eff;
}

QRadioButton:disabled {
  background: transparent;
  color: #8a96a8;
  border: 0px;
}

/* --- Scroll areas --- */

QScrollArea {
  border: 1px solid #3a4560;
  border-radius: 5px;
}

QScrollArea > * > QWidget {
  background: #252d3d;
}

QScrollArea QMenu {
  border: 1px solid #3a4560;
  background: #f0f0f0;
  color: #1e2433;
  padding: 0px;
}

/* --- Scrollbars (modern flat style) --- */

QScrollBar:horizontal {
  border: none;
  background: #1e2433;
  height: 8px;
  margin: 0;
}

QScrollBar:vertical {
  border: none;
  background: #1e2433;
  width: 8px;
  margin: 0;
}

QScrollBar::handle:horizontal {
  background: #3a4560;
  border-radius: 4px;
  min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
  background: #4a9eff;
}

QScrollBar::handle:vertical {
  background: #3a4560;
  border-radius: 4px;
  min-height: 24px;
}

QScrollBar::handle:vertical:hover {
  background: #4a9eff;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  width: 0;
  height: 0;
  background: none;
  border: none;
}

/* --- Table/Tree/List views --- */

QHeaderView::section {
  border: 1px solid #1e2433;
  background-color: #2c3448;
  color: #e0e6f0;
  padding: 3px 4px;
  margin: 0px;
}

QHeaderView {
  border-width: 0px;
  background-color: #2c3448;
}

QTableView QTableCornerButton::section {
  background-color: #2c3448;
}

QHeaderView::down-arrow {
  image: url(:/diagona/icons/diagona/icons/arrow-270-small.png);
  subcontrol-position: bottom left;
}

QHeaderView::up-arrow {
  image: url(:/diagona/icons/diagona/icons/arrow-090-small.png);
  subcontrol-position: bottom left;
}

QTableView, QTreeView, QListView {
  border: 1px solid #3a4560;
  border-radius: 5px;
  background-color: #1e2433;
  alternate-background-color: #252d3d;
  selection-background-color: rgba(74, 158, 255, 0.35);
  selection-color: #e0e6f0;
  gridline-color: transparent;
  margin: 2px;
  padding: 1px;
}

QTableView::item:selected {
  background-color: rgba(74, 158, 255, 0.35);
  color: #e0e6f0;
}

QListView::item:selected {
  background-color: rgba(74, 158, 255, 0.35);
  color: #e0e6f0;
}

QTreeView {
  show-decoration-selected: 1;
}

QTreeView::item {
  border: 0px;
  padding: 2px;
}

QTreeView::item:hover {
  background: rgba(74, 158, 255, 0.15);
}

QTreeView::item:selected {
  background: rgba(74, 158, 255, 0.35);
}

QTreeView::branch:open:has-children {
  image: url(:/diagona/icons/diagona/icons/toggle.png);
}

QTreeView::branch:closed:has-children {
  image: url(:/diagona/icons/diagona/icons/toggle-expand.png);
}

/* --- Slider --- */

QSlider {
  min-height: 2em;
}

QSlider::groove:horizontal {
  border: 1px solid #3a4560;
  height: 4px;
  background: #252d3d;
  border-radius: 2px;
}

QSlider::handle:horizontal {
  background: #4a9eff;
  border: 1px solid #3a4560;
  width: 16px;
  margin: -6px 0;
  border-radius: 8px;
}

QSizeGrip {
  image: url(:/diagona/icons/diagona/icons/arrow-in-out.png);
  padding: 0px 20px 0px 0px;
  width: 16px;
  height: 16px;
}

/* --- Status bar --- */

QStatusBar {
  background: transparent;
  min-height: 20px;
}

QStatusBar::item {
  border: none;
}

QStatusBar QLabel {
  border: none;
  padding-left: 5px;
}

#btn_StatusBarWarnsb_MainStatusBar {
  background-color: #f0b429;
  color: #1e2433;
}

#btn_StatusBarErrorsb_MainStatusBar {
  background-color: #e05c5c;
  color: #ffffff;
}

/* --- Tooltip --- */

QToolTip {
  color: #e0e6f0;
  background-color: #252d3d;
  border: 1px solid #4a9eff;
  border-radius: 4px;
  padding: 3px 6px;
}

/* --- Level meter --- */

swift--gui--CLevelMeter {
  qproperty-lowColor: #8a96a8;
  border: 1px solid #3a4560;
  border-radius: 5px;
  padding: 1px;
  height: 1em;
}

/* --- Supervisor messages --- */

QTabBar::tab[supervisormsg=true] { background-color: #e05c5c; color: #ffffff; }
QTextEdit[supervisormsg=true] { border: 2px solid #e05c5c; margin: 2px; }
QTabBar QToolButton[supervisormsg=true] { background-color: #e05c5c; }

/* --- Config Wizard --- */

QWizard {
  background-color: #1e2433;
}

QWizardPage {
  background-color: #252d3d;
}

#pb_WizardNext,
#pb_WizardFinish {
  background-color: rgba(62, 207, 142, 0.30);
  border-color: #3ecf8e;
  color: #e0e6f0;
  min-width: 80px;
}

#pb_WizardNext:hover,
#pb_WizardFinish:hover {
  background-color: rgba(62, 207, 142, 0.50);
}

#pb_WizardSkip {
  background-color: rgba(58, 69, 96, 0.50);
  color: #8a96a8;
  border-color: #3a4560;
}

#pb_WizardSkip:hover {
  background-color: rgba(58, 69, 96, 0.80);
  color: #e0e6f0;
}
