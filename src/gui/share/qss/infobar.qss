/** style is applied to a CDockWidgetInfoBar **/
/** frameless is dynamic property **/
/** "xpdrmode", m_transponder.getTransponderMode **/
/** "xpdrmodeshort", m_transponder.getModeAsShortString **/

swift--gui--CDockWidgetInfoBar {
  background: #1e2433;
  min-height: 1.5em;
}

swift--gui--CDockWidgetInfoBar[floating="true"] {
  min-width: 50em;
}

swift--gui--Components--CTransponderModeComponent {
  padding: 0px;
  margin: 0px;
}

/* Transponder mode colours — semantic, retained for ATC legibility */
QToolButton[xpdrmodeshort="I"] {
  background-color: #f0b429;
  color: #1e2433;
  border-radius: 4px;
}

QToolButton[xpdrmodeshort="C"] {
  background-color: #3ecf8e;
  color: #1e2433;
  border-radius: 4px;
}

QToolButton[xpdrmodeshort="S"] {
  background-color: #4a9eff;
  color: #1e2433;
  border-radius: 4px;
}

swift--gui--Components--CInfoBarStatusComponent {
  padding-left: 1.0em;
  padding-right: 1.0em;
}

QLabel {
  margin: 0px;
  padding-left: 0.5em;
  padding-right: 0.25em;
  padding-bottom: 0px;
  padding-top: 0px;
  border: 0px;
}
