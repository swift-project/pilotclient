/* main GUI parts */

/* style when main window is frameless */
#wi_CentralWidgetOutside[framelessMainWindow="true"] {
  background-color: #1e2433;
  margin: 0px;
  border: 2px solid #3a4560;
  border-radius: 14px;
}

#fr_CentralFrameInside {
  margin-right: 5px;
  margin-left: 5px;
  margin-top: 2px;
  margin-bottom: 5px;
}

#gb_AtcStationsOnlineInfo {
  border-style: none;
}

#sw_MainMiddle {
  padding: 3px;
  border: 1px solid #3a4560;
  border-radius: 8px;
  background-color: #252d3d;
}

/* close button with frameless windows */
#pb_FramelessCloseButton {
  background: transparent;
  padding: 5px 5px 0px 0px;
  image-position: right;
  margin: 0px;
  border: 0px;
}

/* for FontDialog etc. */
#comp_Settings QToolButton {
  background-color: rgba(74, 158, 255, 0.22);
  border-style: none;
  border-radius: 3px;
  color: #e0e6f0;
}

#wi_MainKeypadArea QPushButton {
  background-color: #1e2433;
  color: #e0e6f0;
  border-style: solid;
  border-width: 1px;
  border-radius: 6px;
  border-color: #3a4560;
  max-height: 20px;
  min-width: 60px;
  min-height: 20px;
}

#wi_MainKeypadArea QPushButton:checked {
  border-style: solid;
  border-color: #4a9eff;
  border-width: 2px;
  font: bold;
  color: #e0e6f0;
}

#wi_MainKeypadArea QPushButton#pb_Connect:checked {
  background-color: rgba(62, 207, 142, 0.28);
  border-color: #3ecf8e;
  color: #e0e6f0;
}

#wi_MainKeypadArea QPushButton:pressed {
  background-color: rgba(74, 158, 255, 0.35);
}

#wi_MainKeypadArea QPushButton:hover {
  border-color: #4a9eff;
  background-color: rgba(74, 158, 255, 0.15);
}

/* cockpit needs to come after sw_MainMiddle */
#comp_CockpitComComponent QPushButton {
  background-color: transparent;
  border-style: solid;
  border-radius: 3px;
  border-width: 0px;
  border-color: #3a4560;
  color: #4a9eff;
  padding: 1px;
  margin: 2px;
}

/* fixes scroll area for audio setup and inner background */
#sa_AudioSetup { background-color: #1e2433; }
#sa_AudioComponentInner {
  background-color: #252d3d;
}

/* COM panel */
#wip_CockpitComPanelShowHideBar QPushButton {
  background-color: transparent;
  border-style: solid;
  border-radius: 3px;
  border-width: 0px;
  border-color: #3a4560;
}

#lep_CommandLineInput {
  background: #1e2433;
  margin-bottom: 5px;
  padding: 3px;
  border: 1px solid #4a9eff;
  border-radius: 5px;
}

#gb_hotkey #gb_action #gb_machine {
  background-color: #252d3d;
}
